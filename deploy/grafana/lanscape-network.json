{
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "title": "Lanscape — network",
  "uid": "lanscape-network",
  "description": "Paths, verdicts, agents and runs exported by the Lanscape server (/metrics).",
  "tags": ["lanscape", "network"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "segment",
        "label": "Segment",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {"query": "label_values(lanscape_path_verdict, segment)", "refId": "segment"},
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"},
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Agents online",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(lanscape_agent_up)"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}
    },
    {
      "id": 2, "type": "stat", "title": "Agents offline",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "count(lanscape_agent_up == 0) or vector(0)"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },
    {
      "id": 3, "type": "stat", "title": "Devices",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "lanscape_devices"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4, "type": "stat", "title": "Paths by verdict",
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "count(lanscape_path_verdict{segment=~\"$segment\"} == 0) or vector(0)", "legendFormat": "green"},
        {"refId": "B", "expr": "count(lanscape_path_verdict{segment=~\"$segment\"} == 2) or vector(0)", "legendFormat": "yellow"},
        {"refId": "C", "expr": "count(lanscape_path_verdict{segment=~\"$segment\"} == 3) or vector(0)", "legendFormat": "CPU-bound"},
        {"refId": "D", "expr": "count(lanscape_path_verdict{segment=~\"$segment\"} == 4) or vector(0)", "legendFormat": "red"}
      ],
      "fieldConfig": {"overrides": [
        {"matcher": {"id": "byName", "options": "green"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
        {"matcher": {"id": "byName", "options": "yellow"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
        {"matcher": {"id": "byName", "options": "CPU-bound"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}]},
        {"matcher": {"id": "byName", "options": "red"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "textMode": "value_and_name"}
    },
    {
      "id": 5, "type": "table", "title": "Paths (last run)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "lanscape_path_throughput_bits_per_second{segment=~\"$segment\"}", "format": "table", "instant": true},
        {"refId": "B", "expr": "lanscape_path_rtt_seconds{segment=~\"$segment\"}", "format": "table", "instant": true},
        {"refId": "C", "expr": "lanscape_path_loss_ratio{segment=~\"$segment\"}", "format": "table", "instant": true},
        {"refId": "D", "expr": "lanscape_path_verdict{segment=~\"$segment\"}", "format": "table", "instant": true}
      ],
      "transformations": [
        {"id": "merge"},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
          "renameByName": {"Value #A": "throughput", "Value #B": "RTT", "Value #C": "loss", "Value #D": "verdict"}
        }}
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {"matcher": {"id": "byName", "options": "throughput"}, "properties": [{"id": "unit", "value": "bps"}]},
          {"matcher": {"id": "byName", "options": "RTT"}, "properties": [{"id": "unit", "value": "s"}]},
          {"matcher": {"id": "byName", "options": "loss"}, "properties": [{"id": "unit", "value": "percentunit"}]},
          {"matcher": {"id": "byName", "options": "verdict"}, "properties": [
            {"id": "mappings", "value": [{"type": "value", "options": {
              "0": {"text": "green", "color": "green"}, "1": {"text": "no data", "color": "text"}, "2": {"text": "yellow", "color": "yellow"},
              "3": {"text": "CPU-bound", "color": "purple"}, "4": {"text": "red", "color": "red"}}}]},
            {"id": "custom.cellOptions", "value": {"type": "color-background"}}
          ]}
        ]
      }
    },
    {
      "id": 6, "type": "timeseries", "title": "Throughput per path",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "lanscape_path_throughput_bits_per_second{segment=~\"$segment\"}",
        "legendFormat": "{{src}}.{{src_if}} → {{dst}}.{{dst_if}} ({{segment}})"}],
      "fieldConfig": {"defaults": {"unit": "bps", "custom": {"lineInterpolation": "stepAfter"}}}
    },
    {
      "id": 7, "type": "timeseries", "title": "RTT per path",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "lanscape_path_rtt_seconds{segment=~\"$segment\"}",
        "legendFormat": "{{src}}.{{src_if}} → {{dst}}.{{dst_if}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineInterpolation": "stepAfter"}}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Problems by kind",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "lanscape_problems", "legendFormat": "{{kind}}"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}}}}
    },
    {
      "id": 9, "type": "timeseries", "title": "Runs and duration",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "sum by (kind, status) (increase(lanscape_runs_total[$__rate_interval]))", "legendFormat": "{{kind}} {{status}}"},
        {"refId": "B", "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(lanscape_run_duration_seconds_bucket[1h])))", "legendFormat": "median duration {{kind}}"}
      ],
      "fieldConfig": {"overrides": [{"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [
        {"id": "unit", "value": "s"}, {"id": "custom.axisPlacement", "value": "right"}]}]}
    },
    {
      "id": 10, "type": "state-timeline", "title": "Agents",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 31},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "lanscape_agent_up", "legendFormat": "{{name}} ({{kind}})"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {
        "0": {"text": "offline", "color": "red"}, "1": {"text": "online", "color": "green"}}}]}}
    }
  ]
}
