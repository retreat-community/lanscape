<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by `lanscape-agent service install --server ... --token ...`; kept here as reference. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.lanscape.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/lanscape-agent</string>
    <string>--server</string><string>lanscape.lan:8443</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/usr/local/var/log/lanscape-agent.log</string>
</dict>
</plist>
