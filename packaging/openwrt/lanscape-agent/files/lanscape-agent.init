#!/bin/sh /etc/rc.common
# Lanscape agent

START=95
STOP=10
USE_PROCD=1

append_part() {
	local opt=$1 part=$2
	config_get_bool v agent "$opt" 1
	[ "$v" = 1 ] && parts="${parts:+$parts,}$part"
}

start_service() {
	local enabled server token ca name exclude dur streams udp parts sources
	config_load lanscape
	config_get_bool enabled agent enabled 0
	config_get server agent server
	config_get token agent token
	config_get ca agent ca_fingerprint
	config_get name agent name
	config_get exclude agent exclude 'wan*,pppoe-*'
	config_get dur agent max_duration 30
	config_get streams agent max_streams 8
	config_get udp agent max_udp_mbps 1000
	[ "$enabled" = 1 ] || return 0
	if [ -z "$server" ]; then
		echo "lanscape-agent: set lanscape.agent.server" >&2
		return 1
	fi
	parts=
	append_part leases leases
	append_part wifi wifi
	append_part forwards forwards
	parts="${parts:-none},sqm"
	sources=openwrt
	config_get_bool v agent mdns 1
	[ "$v" = 1 ] && sources="$sources,mdns"
	config_get_bool v agent ssdp 1
	[ "$v" = 1 ] && sources="$sources,ssdp"
	procd_open_instance
	procd_set_param command /usr/bin/lanscape-agent run --server "$server" --data-dir /etc/lanscape-agent \
		--exclude "$exclude" --max-duration "${dur}s" --max-streams "$streams" --max-udp-mbps "$udp" \
		--discover "$sources" --openwrt-parts "$parts" --local-socket /var/run/lanscape-agent.sock \
		--nut off --smart off --zfs off
	[ -n "$token" ] && procd_append_param command --token "$token"
	[ -n "$ca" ] && procd_append_param command --ca-fingerprint "$ca"
	[ -n "$name" ] && procd_append_param command --name "$name"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lanscape
}
