config agent 'agent'
	option enabled '0'
	# gateway of the Lanscape server, host:8443
	option server ''
	# registration token (lsr_...) from Settings -> Agents -> Add node; used on the first start only
	option token ''
	option ca_fingerprint ''
	option name ''
	# interfaces never used for tests
	option exclude 'wan*,pppoe-*,tailscale*,docker*,veth*,lxc*,virbr*,wg*'
	option max_duration '30'
	option max_streams '8'
	option max_udp_mbps '1000'
	# discovery sources
	option leases '1'
	option wifi '1'
	option forwards '1'
	option mdns '1'
	option ssdp '1'
