#!/bin/sh /etc/rc.common
# Lanscape Mini agent

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled server token
	config_load lsm
	config_get_bool enabled agent enabled 0
	config_get server agent server
	config_get token agent token
	[ "$enabled" = 1 ] || return 0
	if [ -z "$server" ] || [ -z "$token" ]; then
		echo "lsm-agent: set lsm.agent.server and lsm.agent.token" >&2
		return 1
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/lsm-agent -c /etc/config/lsm
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lsm
}
