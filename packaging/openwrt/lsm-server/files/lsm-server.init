#!/bin/sh /etc/rc.common
# Lanscape Mini server

START=94
STOP=10
USE_PROCD=1

start_service() {
	local enabled token data_file
	config_load lsm
	config_get_bool enabled server enabled 0
	config_get token server token
	config_get data_file server data_file /etc/lsm/runs.json
	[ "$enabled" = 1 ] || return 0
	if [ -z "$token" ]; then
		echo "lsm-server: set lsm.server.token" >&2
		return 1
	fi
	mkdir -p "$(dirname "$data_file")"
	procd_open_instance
	procd_set_param command /usr/sbin/lsm-server -c /etc/config/lsm
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lsm
}
