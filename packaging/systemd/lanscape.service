[Unit]
Description=Lanscape server
Documentation=https://github.com/retreat-community/lanscape
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/lanscape/lanscape.env
ExecStart=/usr/bin/lanscape serve --data-dir /var/lib/lanscape
User=lanscape
Group=lanscape
Restart=always
RestartSec=5
StateDirectory=lanscape
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/lanscape

[Install]
WantedBy=multi-user.target
